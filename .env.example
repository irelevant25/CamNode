# ---------------------------------------------------------------------------
# camera-recordings – environment configuration
# Copy to .env (local) or paste into the Portainer stack "Environment variables"
# ---------------------------------------------------------------------------

# HTTP port the UI/API listens on
PORT=8080

# Where the SQLite database, recordings and snapshots are stored.
# Inside Docker this is a volume mount point, keep it as /data.
DATA_DIR=/data

# Secret used to sign session cookies and to encrypt camera passwords in the DB.
# CHANGE THIS. If you change it later, stored camera passwords must be re-entered.
APP_SECRET=please-change-me-to-a-long-random-string

# Initial admin account. Only used the very first time the database is created –
# changing these later does nothing, use `npm run reset-password -- <password>`.
# If ADMIN_PASSWORD is unset the account is created as admin / admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Session lifetime (hours)
SESSION_HOURS=72

# Address cameras use to POST ONVIF event notifications back to this server.
# Leave empty on a normal LAN and it is detected automatically. In Docker the
# container IP is not reachable from the camera, so set this to the host, e.g.
# PUBLIC_URL=http://192.168.1.10:8080
PUBLIC_URL=

# Path to ffmpeg / ffprobe binaries (leave empty to use the ones on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Timezone used for folder names and displayed timestamps
TZ=Europe/Bratislava

# Log level: error | warn | info | debug
LOG_LEVEL=info
